# Supabase project URL and publishable key — used by the browser and server clients.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key — used by the Stripe webhook and to read the site model.
SUPABASE_SECRET_KEY=

# Claude API key — optional; the agent falls back to a scripted interview without it.
ANTHROPIC_API_KEY=

# Stripe secret key — optional; checkout shows a placeholder without it.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=

# Resend API key and sender address for invitation emails.
RESEND_API_KEY=
EMAIL_FROM="Your Business Today <invites@yourbusinesstoday.uk>"

# The Builder — one Claude Code routine per tier, fired by story points.
BUILDER_EASY_ROUTINE_URL=
BUILDER_EASY_ROUTINE_TOKEN=
BUILDER_MEDIUM_ROUTINE_URL=
BUILDER_MEDIUM_ROUTINE_TOKEN=
BUILDER_HARD_ROUTINE_URL=
BUILDER_HARD_ROUTINE_TOKEN=
# Shared secret on the GitHub webhook that reports merged builds.
GITHUB_WEBHOOK_SECRET=
# Where website enquiries from /contact are sent. Leave empty to record leads without emailing.
ENQUIRY_NOTIFICATION_EMAIL=
